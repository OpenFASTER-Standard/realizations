@prefix xsdo: <https://purl.openfaster.org/xsdo/> .
@prefix ofr: <https://openfaster.org/realizations/schema#> .
@prefix kafe: <https://openfaster.org/kafe/schema#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .
@prefix IO: <https://purl.openfaster.org/io/IO_> .

# kafe-standardtypes.xsd, NatP_Struct (verified against the real file,
# 2026-09-01: real particle order is Anrede(1), Titel(2), Vorname(3),
# Nachname(4) -- Vorname/Nachname are the only two fields with a curated
# IO: concept so far; Anrede/Titel are kept as structural placeholders so
# xsdo:particlePosition stays faithful to real document order.

kafe:NatP_Struct a xsdo:ComplexTypeDefinition ;
    xsdo:targetNamespace "urn:bzst:kafe:ozg:v1"^^xs:anyURI ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:NatP_Anrede ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 0 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:NatP_Titel ] ,
            [ xsdo:particlePosition 3 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:NatP_Vorname ] ,
            [ xsdo:particlePosition 4 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:NatP_Nachname ]
    ] .

kafe:NatP_Anrede a xsdo:ElementDeclaration ;
    xsdo:name "Anrede" ;
    xsdo:type kafe:Anrede_ENUM ;
    ofr:realizesConcept IO:0000003 .

kafe:Anrede_ENUM a xsdo:SimpleTypeDefinition ;
    xsdo:baseTypeDefinition xs:string ;
    xsdo:derivationMethod xsdo:restriction ;
    xsdo:hasEnumerationValue
        kafe:Anrede_FRAU , kafe:Anrede_HERR , kafe:Anrede_KEINE_ANREDE .

kafe:Anrede_FRAU a xsdo:EnumerationValue ;
    xsdo:literalValue "FRAU" ;
    ofr:realizesConcept IO:0000004 .

kafe:Anrede_HERR a xsdo:EnumerationValue ;
    xsdo:literalValue "HERR" ;
    ofr:realizesConcept IO:0000005 .

kafe:Anrede_KEINE_ANREDE a xsdo:EnumerationValue ;
    xsdo:literalValue "KEINE_ANREDE" ;
    ofr:realizesConcept IO:0000006 .

kafe:NatP_Titel a xsdo:ElementDeclaration ;
    xsdo:name "Titel" .    # not yet curated -- no IO: concept assigned

kafe:NatP_Vorname a xsdo:ElementDeclaration ;
    xsdo:name "Vorname" ;
    xsdo:type kafe:Vorname_Type ;
    ofr:realizesConcept IO:0000001 .

kafe:NatP_Nachname a xsdo:ElementDeclaration ;
    xsdo:name "Nachname" ;
    xsdo:type kafe:Nachname_Type ;
    ofr:realizesConcept IO:0000002 .

kafe:Vorname_Type a xsdo:SimpleTypeDefinition ;
    xsdo:baseTypeDefinition xs:string ;
    xsdo:derivationMethod xsdo:restriction ;
    xsdo:minLength 1 ;
    xsdo:maxLength 80 .

kafe:Nachname_Type a xsdo:SimpleTypeDefinition ;
    xsdo:baseTypeDefinition xs:string ;
    xsdo:derivationMethod xsdo:restriction ;
    xsdo:minLength 1 ;
    xsdo:maxLength 120 .

# Extends this module (2026-09-02, see bulk-platform's
# docs/superpowers/specs/2026-09-02-nested-repeating-entity-abox-design.md):
# real containment/repetition/role structure around NatP_Struct. Real
# particle positions verified directly against kafe.xsd/kafe-standardtypes.xsd
# -- every uncurated-but-real particle gets a typeless placeholder
# ElementDeclaration at its true position, same convention NatP_Titel above
# already established. NichtNatP_Struct paths (the other branch of every
# real xs:choice here) are deliberately never modeled -- see the spec's
# Addendum.

kafe:KAFE_CType a xsdo:ComplexTypeDefinition ;
    xsdo:targetNamespace "urn:bzst:kafe:ozg:v1"^^xs:anyURI ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 0 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:KAFE_BevollmaechtigtePerson ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:KAFE_Antraege ]
    ] .

kafe:KAFE_BevollmaechtigtePerson a xsdo:ElementDeclaration ;
    xsdo:name "BevollmaechtigtePerson" ;
    xsdo:type kafe:BevollmaechtigtePerson_CType ;
    ofr:impliesRole IO:0000010 .

kafe:KAFE_Antraege a xsdo:ElementDeclaration ;
    xsdo:name "Antraege" ;
    xsdo:type kafe:Antraege_CType .

kafe:BevollmaechtigtePerson_CType a xsdo:ComplexTypeDefinition ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:BevollmaechtigtePerson_NatuerlichePerson ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:BevollmaechtigtePerson_BevAdresse ] ,
            [ xsdo:particlePosition 3 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:BevollmaechtigtePerson_Befugnis ]
    ] .

kafe:BevollmaechtigtePerson_NatuerlichePerson a xsdo:ElementDeclaration ;
    xsdo:name "NatuerlichePerson" ;
    xsdo:type kafe:NatP_Struct .

kafe:BevollmaechtigtePerson_BevAdresse a xsdo:ElementDeclaration ;
    xsdo:name "BevAdresse" .    # not yet curated -- no type, structural placeholder

kafe:BevollmaechtigtePerson_Befugnis a xsdo:ElementDeclaration ;
    xsdo:name "Befugnis" .      # not yet curated -- no type, structural placeholder

kafe:Antraege_CType a xsdo:ComplexTypeDefinition ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 500 ;
              xsdo:term kafe:Antraege_Erstattungsantrag ]
    ] .

kafe:Antraege_Erstattungsantrag a xsdo:ElementDeclaration ;
    xsdo:name "Erstattungsantrag" ;
    xsdo:type kafe:Erstattungsantrag_CType .

kafe:Erstattungsantrag_CType a xsdo:ComplexTypeDefinition ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:Erstattungsantrag_Anliegen ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:Erstattungsantrag_AllgAngaben ] ,
            [ xsdo:particlePosition 3 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:Erstattungsantrag_SteuerlicheBehandlung ] ,
            [ xsdo:particlePosition 4 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:Erstattungsantrag_Zahlungsweg ] ,
            [ xsdo:particlePosition 5 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:Erstattungsantrag_BesteuerteErtraege ] ,
            [ xsdo:particlePosition 6 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:Erstattungsantrag_Erklaerungen ]
    ] .

kafe:Erstattungsantrag_Anliegen a xsdo:ElementDeclaration ;
    xsdo:name "Anliegen" .                    # not yet curated -- placeholder

kafe:Erstattungsantrag_AllgAngaben a xsdo:ElementDeclaration ;
    xsdo:name "AllgAngaben" ;
    xsdo:type kafe:AllgAngaben_CType .

kafe:Erstattungsantrag_SteuerlicheBehandlung a xsdo:ElementDeclaration ;
    xsdo:name "SteuerlicheBehandlung" .       # not yet curated -- placeholder

kafe:Erstattungsantrag_Zahlungsweg a xsdo:ElementDeclaration ;
    xsdo:name "Zahlungsweg" .                 # not yet curated -- placeholder

kafe:Erstattungsantrag_BesteuerteErtraege a xsdo:ElementDeclaration ;
    xsdo:name "BesteuerteErtraege" .          # not yet curated -- placeholder

kafe:Erstattungsantrag_Erklaerungen a xsdo:ElementDeclaration ;
    xsdo:name "Erklaerungen" .                # not yet curated -- placeholder

kafe:AllgAngaben_CType a xsdo:ComplexTypeDefinition ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 0 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:AllgAngaben_Vollmacht ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:AllgAngaben_SteuerpflichtigePerson ] ,
            [ xsdo:particlePosition 3 ; xsdo:minOccurs 0 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:AllgAngaben_GesetzlicheVertretung ] ,
            [ xsdo:particlePosition 4 ; xsdo:minOccurs 0 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:AllgAngaben_Ansprechperson ]
    ] .

kafe:AllgAngaben_Vollmacht a xsdo:ElementDeclaration ;
    xsdo:name "Vollmacht" .                   # not yet curated -- placeholder

kafe:AllgAngaben_SteuerpflichtigePerson a xsdo:ElementDeclaration ;
    xsdo:name "SteuerpflichtigePerson" ;
    xsdo:type kafe:StpflPerson_Struct ;
    ofr:impliesRole IO:0000008 .

kafe:AllgAngaben_GesetzlicheVertretung a xsdo:ElementDeclaration ;
    xsdo:name "GesetzlicheVertretung" ;
    xsdo:type kafe:GesetzlicheVertretung_Struct ;
    ofr:impliesRole IO:0000009 .

kafe:AllgAngaben_Ansprechperson a xsdo:ElementDeclaration ;
    xsdo:name "Ansprechperson" .              # not yet curated -- placeholder

kafe:StpflPerson_Struct a xsdo:ComplexTypeDefinition ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:StpflPerson_NatuerlichePerson ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:StpflPerson_StpflAdresse ]
    ] .

kafe:StpflPerson_NatuerlichePerson a xsdo:ElementDeclaration ;
    xsdo:name "NatuerlichePerson" ;
    xsdo:type kafe:StpflNatP_Struct .

kafe:StpflPerson_StpflAdresse a xsdo:ElementDeclaration ;
    xsdo:name "StpflAdresse" .                # not yet curated -- placeholder

kafe:StpflNatP_Struct a xsdo:ComplexTypeDefinition ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:StpflNatP_NatP ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:StpflNatP_Geburtsdatum ]
    ] .

kafe:StpflNatP_NatP a xsdo:ElementDeclaration ;
    xsdo:name "NatP" ;
    xsdo:type kafe:NatP_Struct .

kafe:StpflNatP_Geburtsdatum a xsdo:ElementDeclaration ;
    xsdo:name "Geburtsdatum" .                # not yet curated -- placeholder

kafe:GesetzlicheVertretung_Struct a xsdo:ComplexTypeDefinition ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle
            [ xsdo:particlePosition 1 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:GesetzlicheVertretung_NatuerlichePerson ] ,
            [ xsdo:particlePosition 2 ; xsdo:minOccurs 1 ; xsdo:maxOccurs 1 ;
              xsdo:term kafe:GesetzlicheVertretung_GVAdresse ]
    ] .

kafe:GesetzlicheVertretung_NatuerlichePerson a xsdo:ElementDeclaration ;
    xsdo:name "NatuerlichePerson" ;
    xsdo:type kafe:NatP_Struct .

kafe:GesetzlicheVertretung_GVAdresse a xsdo:ElementDeclaration ;
    xsdo:name "GVAdresse" .                   # not yet curated -- placeholder

# Workbook-only pseudo-field: NOT a real KaFE XSD element, never wired into
# any content model above, never emitted into XML. Exists purely so the
# Personen sheet's Role column can reuse the existing EnumerationValue/
# dropdown machinery (xlsx_generator.py's _enumeration_tokens,
# xlsx_ingest.py's _resolve_enumeration_value) instead of a second
# dropdown-sourcing mechanism -- see the spec's Addendum.

kafe:PersonRolle_Field a xsdo:ElementDeclaration ;
    xsdo:name "PersonRolle" ;
    xsdo:type kafe:PersonRolle_ENUM ;
    ofr:realizesConcept IO:0000007 .

kafe:PersonRolle_ENUM a xsdo:SimpleTypeDefinition ;
    xsdo:baseTypeDefinition xs:string ;
    xsdo:derivationMethod xsdo:restriction ;
    xsdo:hasEnumerationValue
        kafe:PersonRolle_STEUERPFLICHTIG , kafe:PersonRolle_GESETZLICHE_VERTRETUNG , kafe:PersonRolle_BEVOLLMAECHTIGT .

kafe:PersonRolle_STEUERPFLICHTIG a xsdo:EnumerationValue ;
    xsdo:literalValue "STEUERPFLICHTIGE_PERSON" ;
    ofr:realizesConcept IO:0000008 .

kafe:PersonRolle_GESETZLICHE_VERTRETUNG a xsdo:EnumerationValue ;
    xsdo:literalValue "GESETZLICHE_VERTRETUNG" ;
    ofr:realizesConcept IO:0000009 .

kafe:PersonRolle_BEVOLLMAECHTIGT a xsdo:EnumerationValue ;
    xsdo:literalValue "BEVOLLMAECHTIGTE_PERSON" ;
    ofr:realizesConcept IO:0000010 .
